# Copia este archivo como .env y ajusta los valores.
# .env NUNCA se sube al repositorio (está en .gitignore).

# --- Django ---
# Genera una con: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# --- LLM ---
# anthropic | demo. Si ANTHROPIC_API_KEY está vacía, se usa el modo demo automáticamente.
LLM_PROVEEDOR=anthropic
LLM_MODELO=claude-haiku-5-5
ANTHROPIC_API_KEY=

# --- Agente y matching ---
AGENTE_MAX_ITERACIONES=8
MATCH_PESO_DETERMINISTA=0.6
